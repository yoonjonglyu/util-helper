      "default": "./dist/dom/index.js"
    },
    "./export": {
      "types": "./dist/export/index.d.ts",
      "import": "./dist/export/index.js",
      "require": "./dist/export/index.js",
      "default": "./dist/export/index.js"
    },
    "./format": {
      "types": "./dist/format/index.d.ts",
      "import": "./dist/format/index.js",
      "require": "./dist/format/index.js",
      "default": "./dist/format/index.js"
    },
    "./import": {
      "types": "./dist/import/index.d.ts",
      "import": "./dist/import/index.js",
      "require": "./dist/import/index.js",
      "default": "./dist/import/index.js"
    },
    "./querystring": {
      "types": "./dist/querystring/index.d.ts",
      "import": "./dist/querystring/index.js",
