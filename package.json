      "default": "./dist/querystring/index.js"
    },
    "./security": {
      "types": "./dist/security/index.d.ts",
      "import": "./dist/security/index.js",
      "require": "./dist/security/index.js",
      "default": "./dist/security/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "import": "./dist/storage/index.js",
      "require": "./dist/storage/index.js",
      "default": "./dist/storage/index.js"
    },
    "./typecheck": {
      "types": "./dist/typecheck/index.d.ts",
      "import": "./dist/typecheck/index.js",
      "require": "./dist/typecheck/index.js",
      "default": "./dist/typecheck/index.js"
    },
    "./array": {
      "types": "./dist/array/index.d.ts",
      "import": "./dist/array/index.js",
      "require": "./dist/array/index.js",
      "default": "./dist/array/index.js"
    },
    "./object": {
      "types": "./dist/object/index.d.ts",
      "import": "./dist/object/index.js",
      "require": "./dist/object/index.js",
      "default": "./dist/object/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "jest --watchAll=false",
    "test:watch": "jest --watchAll",
    "publish:npm": "rimraf dist &&  babel src -d dist --extensions \".ts\" --ignore **/*.test.ts",
    "publish:type": "tsc --declaration --allowJs --emitDeclarationOnly --outDir dist",
    "build": "yarn publish:npm && yarn publish:type"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yoonjonglyu/util-helper.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/yoonjonglyu/util-helper/issues"
